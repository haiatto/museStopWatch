# museStopWatch mini-app exports, API version 1.
#
# What a mini app may call besides the msw_* functions of include/msw_app.h
# (those are exported automatically). tools/gen_msw_exports.py turns this
# file into the firmware's symbol table
# (muse-gadget-sdk/esp32/components/miniapp/msw_app_exports.c) and the SDK's
# link check stub (sdk/stub/msw_stub.c).
#
# One symbol a line. "name = impl" exports impl under name. "data name" is
# a variable (a font), not a function. "# ..." is a comment.
# elf_loader also exports a few of the C library itself (malloc, printf,
# memcpy, strlen ...); entries here win over its.

# ---- memory: tracked per app and freed when it ends -------------------------
malloc = msw_app_malloc
calloc = msw_app_calloc
realloc = msw_app_realloc
free = msw_app_free
strdup = msw_app_strdup

